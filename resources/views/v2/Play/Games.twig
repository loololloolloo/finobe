<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ place.title }} - Finobe</title>
<style>
    /* the 2016 client's loading screen (CoreGui LoadingScript), with its own textures and font from content/ */
    @font-face { font-family: "SourceSans"; src: url("/play/SourceSansPro-Regular.ttf") format("truetype"); }
    html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: #000; overflow: hidden; }
    #canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 1; }
    #mobile-text-input { display: none; position: absolute; z-index: -1; border: none; outline: none; }

    #RobloxLoadingGui { position: absolute; inset: 0; z-index: 2; background: rgb(45, 45, 45) url("/play/darkLoadingTexture.png") repeat;
        font-family: "SourceSans", "Source Sans Pro", Arial, sans-serif; color: #fff; overflow: hidden; transition: opacity .5s; user-select: none; }
    #RobloxLoadingGui.done { opacity: 0; pointer-events: none; }

    #CloseButton { position: absolute; right: 7px; top: 5px; width: 30px; height: 30px; background: url("/play/cancelButton.png") center / contain no-repeat; }

    #GraphicsFrame { position: absolute; right: 95px; bottom: 38px; width: 120px; height: 120px; }
    #LoadingImage { position: absolute; inset: 0; background: url("/play/loadingCircle.png") center / contain no-repeat; animation: spin 1.5s linear infinite; }
    #LoadingText { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 18px; text-shadow: 0 0 1px #000; }
    @keyframes spin { to { transform: rotate(360deg); } }

    #InfoFrame { position: absolute; left: 94px; bottom: 48px; width: 40%; }
    #PlaceLabel { font-size: 32px; line-height: 1.1; text-shadow: 0 0 2px #000, 1px 1px 2px #000; overflow-wrap: anywhere; }
    #CreatorLabel { font-size: 20px; margin-top: 4px; text-shadow: 0 0 2px #000, 1px 1px 2px #000; }

    #ErrorFrame { display: none; position: absolute; left: 25%; top: 0; width: 50%; min-height: 80px; box-sizing: border-box; padding: 5px;
        background: rgb(206, 41, 41); align-items: center; justify-content: center; text-align: center; font-size: 18px; z-index: 3; }
    #RobloxLoadingGui.error #ErrorFrame { display: flex; }

    @media (max-width: 600px) {
        #InfoFrame { left: 16px; bottom: 150px; width: calc(100% - 32px); }
        #PlaceLabel { font-size: 28px; }
        #GraphicsFrame { right: 50%; margin-right: -50px; bottom: 30px; width: 100px; height: 100px; }
        #LoadingText { font-size: 14px; }
        #ErrorFrame { left: 0; width: 100%; }
    }
</style>
</head>
<body>
<input id="mobile-text-input" type="text">
<canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>
<div id="RobloxLoadingGui">
    <a id="CloseButton" href="{{ back }}" title="Leave"></a>
    <div id="ErrorFrame"><span id="ErrorText"></span></div>
    <div id="InfoFrame">
        <div id="PlaceLabel">{{ place.title }}</div>
        <div id="CreatorLabel">By {{ place.creator }}</div>
    </div>
    <div id="GraphicsFrame">
        <div id="LoadingImage"></div>
        <div id="LoadingText">Loading...</div>
    </div>
</div>
<script>
(function () {
    var gui = document.getElementById('RobloxLoadingGui');
    function fail(t) { document.getElementById('ErrorText').textContent = t; gui.classList.add('error'); }

    if (typeof SharedArrayBuffer === 'undefined' || typeof WebAssembly === 'undefined') {
        fail("Your browser can't run Finobe here (it needs WebAssembly threads). Try a recent Chrome, Edge or Firefox.");
        return;
    }

    var Module = {
        canvas: document.getElementById('canvas'),
        joinScript: {{ joinScript|json_encode|raw }},
        yearSelection: "2016",
        touchEnabled: ('ontouchstart' in window) || navigator.maxTouchPoints > 0,
        locateFile: function (path) { return '/webplayer/' + path; },
        mainScriptUrlOrBlob: '/webplayer/WebPlayer.js',
        // the client draws this same loading screen itself once it's running, so hand over to it
        onRuntimeInitialized: function () { setTimeout(function () { gui.classList.add('done'); }, 1500); },
        onAbort: function () { fail('The game crashed. Reload the page to try again.'); },
        showKeyboard: function () { var el = document.getElementById('mobile-text-input'); el.style.display = 'block'; el.select(); },
        hideKeyboard: function () { document.getElementById('mobile-text-input').style.display = 'none'; }
    };
    window.Module = Module;
    window.RBXModule = Module;

    var s = document.createElement('script');
    s.src = '/webplayer/WebPlayer.js';
    s.onerror = function () { fail("Couldn't download the game client. Reload the page to try again."); };
    document.body.appendChild(s);
})();
</script>
</body>
</html>
