<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <div class="container mt-4">
        <h3>Admin Panel</h3>
        {# same tiles as the 2020 admin panel, plus the tools this site added #}
        {% set tools = [
          {url: '/admin/users', label: 'Users', icon: 'user'},
          {url: '/admin/assets', label: 'Assets', icon: 'tshirt'},
          {url: '/admin/bans', label: 'Bans', icon: 'ban'},
          {url: '/admin/decider', label: 'Oui/Non Decider', icon: 'question'},
          {url: '/admin/prune-posts', label: 'Prune Forum Posts', icon: 'trash'},
          {url: '/admin/createxml', label: 'New XML Asset', icon: 'layer-plus'},
          {url: '/admin/rbxcreatexml', label: 'Create XML Asset (Roblox)', image: '/s/img/roblox-r.png'},
          {url: '/admin/give_dius', label: 'Give Dius', icon: 'donate'},
          {url: '/admin/give_badges', label: 'Give Badges', icon: 'award'},
          {url: '/admin/warn', label: 'Give Warning', icon: 'exclamation-triangle'},
          {url: '/admin/announcements', label: 'Site Announcements', icon: 'bullhorn'},
          {url: '/admin/servers', label: 'Game Servers', icon: 'server'},
          {url: '/admin/changeversions', label: 'Client Deployer', icon: 'desktop'},
          {url: '/admin/elections', label: 'Elections', icon: 'vote-yea'},
          {url: '/admin/blog', label: 'Blog Management', icon: 'newspaper'}
        ] %}
        <div class="row mt-4 admin-tiles">
          {% for tool in tools %}
            <div class="col-6 col-md-3 col-lg-2 mb-4">
              <a href="{{ tool.url }}" class="card admin-tile text-center h-100" title="{{ tool.label }}">
                <div class="card-body px-2 py-4">
                  {% if tool.image %}
                    <img src="{{ tool.image }}" alt="" class="admin-tile-icon mb-3">
                  {% else %}
                    <i class="far fa-fw fa-{{ tool.icon }} fa-3x mb-3" aria-hidden="true"></i>
                  {% endif %}
                  <p class="mb-0 text-truncate">{{ tool.label }}</p>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
        <style>
          .admin-tile { color: inherit; border: 0; border-radius: 0; }
          .admin-tile:hover { color: inherit; text-decoration: none; filter: brightness(1.15); }
          .admin-tile .fa-3x { font-size: 2.6em; }
          .admin-tile-icon { height: 2.6em; width: auto; }
        </style>
      </div>
    </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>
